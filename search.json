---
layout: null
---
{"posts":[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},"content":{{ post.content | strip_html | normalize_whitespace | jsonify }},"tags":{{ post.tags | jsonify }},"date":{{ post.date | date: "%Y.%m.%d" | jsonify }},"url":{{ post.url | relative_url | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}